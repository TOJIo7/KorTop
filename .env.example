# Токен Travelpayouts (Aviasales Data API): https://www.travelpayouts.com/ → Профиль → API-токен
TRAVELPAYOUTS_TOKEN=
# Партнёрский маркер Travelpayouts для ссылок на Aviasales
TRAVELPAYOUTS_MARKER=
# Секрет для задач Vercel Cron (/api/warm — прогрев кэша, /api/cron/reminders — напоминания): любая длинная случайная строка
CRON_SECRET=
# Напоминания в Telegram. Бот: @BotFather → /newbot → токен и имя бота (без @)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Секрет вебхука бота: любая длинная случайная строка (латиница, цифры, _ и -)
TELEGRAM_WEBHOOK_SECRET=
# Адрес сайта для ссылки в приветствии бота, например https://kortop.vercel.app
SITE_URL=
# База для дат напоминаний: https://upstash.com → Redis → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
